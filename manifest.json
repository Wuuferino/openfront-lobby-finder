{
  "manifest_version": 3,
  "name": "OpenFront Lobby Targeter",
  "version": "0.3.0",
  "description": "Side panel for OpenFront.io — target lobbies by map, mode, team setup, and modifiers, with auto-join. Auto-hides during gameplay.",
  "action": {
    "default_title": "Open OpenFront",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://openfront.io/*", "https://*.openfront.io/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "tool.js",
        "maps.js",
        "style.css",
        "icons/*"
      ],
      "matches": ["https://openfront.io/*", "https://*.openfront.io/*"]
    }
  ]
}
