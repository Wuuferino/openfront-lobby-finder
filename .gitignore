# Private dev-context for Claude Code — not part of the public extension
CLAUDE.md

# Local dev tools (kept on disk so future sessions can re-run them, but not
# part of the shipped extension and not worth versioning publicly)
gen_icons.py
gen_screenshot.py
build.py

# Extension signing key. The public half lives in manifest.json (intended);
# the private half stays local and is only needed if we ever sign a CRX.
# DO NOT commit. Losing it just means we can't sign updates — the manifest
# public key alone keeps the extension ID stable for unpacked installs.
.keys/

# Build artifacts (we ship zips via GitHub Releases, not the repo)
*.zip

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Anything generated under build/dist if we ever add a build step
node_modules/
dist/
build/
